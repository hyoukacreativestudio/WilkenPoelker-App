# What EAS Build uploads for the mobile app (frontend/).
# EAS uploads the whole repository. On Windows it only applies ignore rules from
# the repository root (nested files like frontend/.gitignore are skipped), and
# while this file exists it ignores .gitignore completely - so everything that
# must never be uploaded is listed here. Directories are written WITHOUT a
# trailing slash so they are skipped entirely (no empty frontend/android, which
# would make EAS skip its own prebuild).

# Dependencies, env files and secrets
node_modules
.env
.env.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
SFTP_TAIFUN_CREDENTIALS.txt
firebase-service-account.json
*-firebase-adminsdk-*.json
google-play-service-account.json
frontend/credentials
frontend/credentials.json

# Native folders are generated by EAS (prebuild); the local ones hold build
# outputs and test-only changes (cleartext for the local test backend)
frontend/android
frontend/ios

# Build outputs, logs, local tooling
frontend/.expo
frontend/dist
frontend/web-build
*.log
logs
*.apk
*.aab
*.ipa
.claude
.vscode
.idea

# Other parts of the repository are not needed for the app build
backend
desktop
legal-review
