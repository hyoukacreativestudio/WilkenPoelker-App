{
  "name": "wilkenpoelker-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "WilkenPoelker company desktop tool (web + Electron) — shares the app backend",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5180",
    "build:electron": "vite build --mode electron --base ./ --outDir dist-electron",
    "electron": "electron .",
    "dist:win": "npm run build:electron && electron-builder --win portable"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.2"
  },
  "build": {
    "appId": "de.wilkenpoelker.desktop",
    "productName": "WilkenPoelker",
    "directories": { "output": "release" },
    "files": ["dist-electron/**/*", "electron/**/*", "build/icon.png"],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "WilkenPoelker.exe"
    }
  }
}
