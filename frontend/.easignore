# EAS Build Ignore File
# Unnötige Dateien vom Build ausschließen

# Node modules (werden beim Build automatisch installiert)
node_modules/

# Tests
__tests__/
*.test.js
*.test.ts
*.test.tsx
*.spec.js
*.spec.ts

# Docs
docs/
*.md
LICENSE

# Development files
.env
.env.local
.env.development

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Native folders are generated by EAS (prebuild). The local ones hold build
# outputs and test-only changes (e.g. cleartext for the local test backend)
# and must never be uploaded - .easignore replaces .gitignore for EAS.
/android
/ios
