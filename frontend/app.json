{
  "expo": {
    "name": "WilkenPoelker",
    "slug": "wilkenpoelker",
    "owner": "wilkenpoelker",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E7D32"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hyoukacreativestudios.wilkenpoelker",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:wilkenpoelker.de",
        "applinks:api.wilkenpoelker.de",
        "webcredentials:wilkenpoelker.de"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "WilkenPoelker benötigt Zugriff auf die Kamera für Profilbilder und Service-Anfragen.",
        "NSPhotoLibraryUsageDescription": "WilkenPoelker benötigt Zugriff auf Ihre Fotos für Profilbilder und Service-Anfragen.",
        "NSFaceIDUsageDescription": "WilkenPoelker nutzt Face ID für die sichere Anmeldung."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E7D32"
      },
      "package": "com.hyoukacreativestudios.wilkenpoelker",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "wilkenpoelker.de",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2E7D32"
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "wilken-poelker",
          "project": "wilkenpoelker-frontend"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://api.wilkenpoelker.de/api",
      "sentryDsn": "https://e9129a17401c7b6f8a4af3887e4f453a@o4511693611335680.ingest.de.sentry.io/4511704458264656",
      "eas": {
        "projectId": "5e6e7adf-e7fc-4693-8382-d5bc1c51d842"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/5e6e7adf-e7fc-4693-8382-d5bc1c51d842"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
